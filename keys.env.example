# Скопіюй цей файл у keys.env (він у .gitignore) і впиши значення після "=".
# Порожні рядки скрипти пропускають. Ключі вставляй ТІЛЬКИ сюди, не в чат.
# Після застосування скрипти стирають записані ключі з keys.env.

# ─────────────── LLM-провайдери (scripts/apply-free-llm-keys.ps1) ───────────────

# OpenRouter: безкоштовні :free-моделі для обох агентів. https://openrouter.ai/settings/keys
# Без жодної покупки — 50 безкоштовних запитів/день; після разової покупки кредитів на $10 — 1000/день.
OPENROUTER_API_KEY=

# NVIDIA Build: Kimi K2.5, GLM-5.1, DeepSeek V3.2. 40 запитів/хв, денного ліміту немає.
# Потрібна верифікація телефону, картка не потрібна. https://build.nvidia.com -> Get API Key (nvapi-...)
NVIDIA_API_KEY=

# Google AI Studio: Gemini Flash / 2.5 Pro, без картки. Запити безкоштовного тарифу йдуть на навчання Google.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Z.ai: GLM-4.7-Flash і GLM-4.5-Flash безкоштовні. https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Mistral, план Experiment: ~1 млрд токенів/міс., ~1 запит/с, потрібен телефон. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenCode Zen: тимчасово безкоштовні моделі (набір змінюється). https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=

# Ollama Cloud: невеликий місячний запас, 1 запит одночасно. https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ─────────────── Telegram-боти (scripts/setup-telegram-bots.ps1) ───────────────
# Створи ДВОХ ботів у @BotFather (/newbot): один для OpenClaw, другий для Hermes.
# Не бери токен бота, який уже десь працює: два процеси на одному токені конфліктують.

OPENCLAW_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_BOT_TOKEN=

# Твій числовий Telegram ID (покаже бот @userinfobot). Лише з цього акаунта ботам можна писати.
TELEGRAM_OWNER_ID=
